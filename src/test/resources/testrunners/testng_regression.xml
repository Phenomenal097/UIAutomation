<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart Test Suite" verbose="1" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.qa.opencart.listeners.ExtentReportListener"/>
    </listeners>

    <test name="Home Page Tests">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.qa.opencart.tests.HomeTest"/>
        </classes>
    </test>

    <test name="Login Page Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qa.opencart.tests.LoginTest"/>
        </classes>
    </test>

</suite>